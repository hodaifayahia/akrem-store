# Copy to .env and adjust. The server reads process.env (no dotenv dependency:
# either export these in your shell, or use `node --env-file=.env src/server.js`).

# Port the API listens on (Vite proxies /api to this port)
PORT=4000

# Admin password for POST /api/admin/login  ->  { "token": "..." }
ADMIN_PASSWORD=admin123

# Secret used to HMAC-sign the admin session token. Change it in production.
TOKEN_SECRET=akrem-change-me-in-production

# Token lifetime in hours
TOKEN_TTL_HOURS=12

# SQLite file (relative paths are resolved from backend/)
# DB_PATH=./data/store.db
