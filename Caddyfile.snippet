# =============================================================================
# Akrem Mobile — reverse proxy examples
# Append one block to your Caddyfile (/etc/caddy/Caddyfile) and reload:
#     sudo systemctl reload caddy
# Akrem Mobile is single-origin: /api/* and the storefront come from the SAME
# upstream (127.0.0.1:8084), so Caddy never has to know about the frontend.
# =============================================================================

# ---- 1. Dedicated subdomain (recommended) ------------------------------------
akrem-store.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8084
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

# ---- 2. Sub-path variant (/shop on an existing site) -------------------------
# NOTE: the subpath form only works when the storefront is BUILT with that base:
#       VITE_BASE=/shop/ npm run build          (or: VITE_BASE=/shop/ docker compose build)
#       `handle_path` strips the /shop prefix before the request reaches Node,
#       so the backend keeps seeing / and /api/... exactly as in variant 1.
#
# shop.example.com {
#     encode zstd gzip
#     handle_path /shop/* {
#         reverse_proxy 127.0.0.1:8084
#     }
#     # Let the app answer its own routes (/shop/cart, /shop/order/AKR-…)
#     handle {
#         redir /shop /shop/ 301
#         reverse_proxy 127.0.0.1:8084
#     }
# }

# ---- 3. Plain nginx equivalent ------------------------------------------------
# server {
#     listen 443 ssl http2;
#     server_name akrem-store.example.com;
#     root /var/www/html;                      # only needed for certbot webroot
#     location / {
#         proxy_pass http://127.0.0.1:8084;    # /api/* and the SPA go to the same upstream
#         proxy_set_header Host $host;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#     }
# }