# =============================================================================
# Akrem Mobile — container environment.  cp .env.example .env  then EDIT IT.
# The server refuses to boot with NODE_ENV=production while ADMIN_PASSWORD is
# unset or still "admin123", or while TOKEN_SECRET is missing.
# =============================================================================

# REQUIRED in production — anything non-empty and different from "admin123".
# The admin panel is at /admin/login.
ADMIN_PASSWORD=change-this-to-a-real-password

# REQUIRED in production — HMAC secret for the admin session token.
# Generate one with:  openssl rand -hex 32
TOKEN_SECRET=change-this-to-a-long-random-string

# Admin session lifetime in hours.
TOKEN_TTL_HOURS=12

# Keep 8084 in sync with the published container port in docker-compose.yml.
PORT=8084

# SQLite file, on the /data named volume (survives `up -d --build`).
DB_PATH=/data/store.db

# Public port on the host (docker-compose publishes "${HOST_PORT:-8084}:8084").
HOST_PORT=8084

# Build-time base path for the storefront: "/" or "/shop/" (see Caddyfile.snippet).
VITE_BASE=/